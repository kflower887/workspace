<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/browser_bg">

    <!-- 상단 툴바 (삼성 인터넷 스타일) -->
    <LinearLayout
        android:id="@+id/topToolbar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="@color/toolbar_bg"
        android:elevation="4dp"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- 뒤로가기 버튼 -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="뒤로"
            android:src="@drawable/ic_arrow_back"
            android:alpha="0.4" />

        <!-- 앞으로가기 버튼 -->
        <ImageButton
            android:id="@+id/btnForward"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="앞으로"
            android:src="@drawable/ic_arrow_forward"
            android:alpha="0.4" />

        <!-- 주소 입력창 (삼성 인터넷 스타일 캡슐형) -->
        <LinearLayout
            android:id="@+id/addressBarContainer"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:layout_gravity="center_vertical"
            android:background="@drawable/address_bar_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="6dp">

            <ImageView
                android:id="@+id/securityIcon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_lock"
                android:layout_marginEnd="4dp"
                android:alpha="0.6" />

            <EditText
                android:id="@+id/etAddressBar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="주소 또는 검색어 입력"
                android:hintTextColor="@color/hint_color"
                android:imeOptions="actionGo"
                android:inputType="textUri"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="@color/address_text"
                android:textSize="13sp" />

            <ImageButton
                android:id="@+id/btnRefresh"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="새로고침"
                android:src="@drawable/ic_refresh" />

        </LinearLayout>

        <!-- 탭 카운터 버튼 (삼성 인터넷 스타일) -->
        <FrameLayout
            android:id="@+id/btnTabCounter"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_tab_counter_bg" />

            <TextView
                android:id="@+id/tvTabCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="1"
                android:textColor="@color/tab_count_text"
                android:textSize="11sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- 메뉴 버튼 -->
        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="메뉴"
            android:src="@drawable/ic_menu" />

    </LinearLayout>

    <!-- 로딩 프로그레스 바 -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:max="100"
        android:progress="0"
        android:progressTint="@color/accent_color"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topToolbar" />

    <!-- 웹뷰 패널 컨테이너 -->
    <LinearLayout
        android:id="@+id/webViewContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/bottomNavBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/progressBar">

        <!-- 패널 구분선 (DUAL/TRIPLE 모드에서 표시) -->
        <!-- WebView 패널들은 코드에서 동적으로 추가됨 -->
    </LinearLayout>

    <!-- 하단 네비게이션 바 (삼성 인터넷 스타일) -->
    <LinearLayout
        android:id="@+id/bottomNavBar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="@color/toolbar_bg"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- 홈 버튼 -->
        <ImageButton
            android:id="@+id/btnHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="홈"
            android:src="@drawable/ic_home" />

        <!-- 북마크 버튼 -->
        <ImageButton
            android:id="@+id/btnBookmark"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="북마크"
            android:src="@drawable/ic_bookmark" />

        <!-- 폴더블 모드 전환 버튼 (핵심 기능) -->
        <FrameLayout
            android:id="@+id/btnFoldableMode"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp">

            <ImageView
                android:id="@+id/ivFoldableMode"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_foldable_dual"
                android:contentDescription="폴더블 모드 전환" />

            <TextView
                android:id="@+id/tvFoldableMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:text="2단"
                android:textColor="@color/accent_color"
                android:textSize="8sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- 히스토리 버튼 -->
        <ImageButton
            android:id="@+id/btnHistory"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="히스토리"
            android:src="@drawable/ic_history" />

        <!-- 설정 버튼 -->
        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="설정"
            android:src="@drawable/ic_settings" />

    </LinearLayout>

    <!-- 패널 구분선 오버레이 (동적으로 표시/숨김) -->
    <View
        android:id="@+id/panelDivider1"
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:background="@color/divider_color"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomNavBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/progressBar" />

    <View
        android:id="@+id/panelDivider2"
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:background="@color/divider_color"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomNavBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/progressBar" />

</androidx.constraintlayout.widget.ConstraintLayout>
