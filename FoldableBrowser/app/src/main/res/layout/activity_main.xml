<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/browser_bg">

    <!-- ── 상단 툴바 ── -->
    <LinearLayout
        android:id="@+id/topToolbar"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:background="@color/toolbar_bg"
        android:elevation="4dp"
        android:orientation="horizontal"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="뒤로"
            android:src="@drawable/ic_arrow_back"
            android:alpha="0.4" />

        <ImageButton
            android:id="@+id/btnForward"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="앞으로"
            android:src="@drawable/ic_arrow_forward"
            android:alpha="0.4" />

        <LinearLayout
            android:id="@+id/addressBarContainer"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:layout_gravity="center_vertical"
            android:background="@drawable/address_bar_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="4dp">

            <ImageView
                android:id="@+id/securityIcon"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:src="@drawable/ic_lock"
                android:layout_marginEnd="3dp"
                android:alpha="0.6" />

            <EditText
                android:id="@+id/etAddressBar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="주소 또는 검색어 입력"
                android:imeOptions="actionGo"
                android:inputType="textUri"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="@color/address_text"
                android:textSize="12sp" />

            <ImageButton
                android:id="@+id/btnRefresh"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="새로고침"
                android:src="@drawable/ic_refresh" />

        </LinearLayout>

        <FrameLayout
            android:id="@+id/btnTabCounter"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_tab_counter_bg" />

            <TextView
                android:id="@+id/tvTabCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="1"
                android:textColor="@color/tab_count_text"
                android:textSize="10sp"
                android:textStyle="bold" />
        </FrameLayout>

        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="메뉴"
            android:src="@drawable/ic_menu" />

    </LinearLayout>

    <!-- ── 컨트롤바 (연동·회전·웹툰모드) ── -->
    <LinearLayout
        android:id="@+id/controlBar"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:background="@color/control_bar_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topToolbar">

        <!-- 스크롤 연동 토글 (길게 누르면 도움말) -->
        <TextView
            android:id="@+id/btnSyncScroll"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@drawable/btn_control_bg"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="연동 OFF"
            android:textColor="@color/sync_off_color"
            android:textSize="11sp"
            android:textStyle="bold"
            android:longClickable="true" />

        <View android:layout_width="6dp" android:layout_height="1dp" />

        <!-- 웹툰 모드 토글 (핵심!) -->
        <TextView
            android:id="@+id/btnWebtoonMode"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@drawable/btn_webtoon_bg"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="🖼 웹툰"
            android:textColor="@color/webtoon_off_color"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- 웹툰 통계 표시 -->
        <TextView
            android:id="@+id/tvWebtoonStats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text=""
            android:textColor="@color/hint_color"
            android:textSize="10sp"
            android:visibility="gone" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- 플랫폼 선택 -->
        <TextView
            android:id="@+id/btnPlatform"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@drawable/btn_control_bg"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="자동"
            android:textColor="@color/hint_color"
            android:textSize="10sp"
            android:visibility="gone" />

        <View android:layout_width="6dp" android:layout_height="1dp" />

        <!-- 화면 회전 -->
        <ImageButton
            android:id="@+id/btnRotate"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/btn_control_bg"
            android:contentDescription="화면 회전"
            android:src="@drawable/ic_rotate"
            android:padding="4dp" />

    </LinearLayout>

    <!-- ── 로딩 프로그레스 ── -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:max="100"
        android:progress="0"
        android:progressTint="@color/accent_color"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/controlBar" />

    <!-- ══════════════════════════════════════════════════════════
         일반 모드: 분할 WebView 컨테이너
    ══════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/webViewContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        android:visibility="visible"
        app:layout_constraintBottom_toTopOf="@id/bottomNavBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/progressBar" />

    <!-- ══════════════════════════════════════════════════════════
         웹툰 모드: 단일 풀스크린 WebView + 정보 오버레이
    ══════════════════════════════════════════════════════════════ -->
    <FrameLayout
        android:id="@+id/webtoonContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomNavBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/progressBar">

        <!-- 웹툰 전용 WebView (코드에서 추가) -->
        <com.foldablebrowser.app.webtoon.WebtoonWebView
            android:id="@+id/webtoonWebView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- 상태 배지 (우하단) -->
        <LinearLayout
            android:id="@+id/webtoonBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="12dp"
            android:background="@drawable/btn_webtoon_badge_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvWebtoonBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🖼 웹툰 최적화 적용"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

    </FrameLayout>

    <!-- ── 하단 네비게이션 바 ── -->
    <LinearLayout
        android:id="@+id/bottomNavBar"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:background="@color/toolbar_bg"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageButton
            android:id="@+id/btnHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="홈"
            android:src="@drawable/ic_home" />

        <ImageButton
            android:id="@+id/btnBookmark"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="북마크"
            android:src="@drawable/ic_bookmark" />

        <FrameLayout
            android:id="@+id/btnFoldableMode"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="6dp">

            <ImageView
                android:id="@+id/ivFoldableMode"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_foldable_dual"
                android:contentDescription="분할 모드 전환" />

            <TextView
                android:id="@+id/tvFoldableMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:text="2단"
                android:textColor="@color/accent_color"
                android:textSize="8sp"
                android:textStyle="bold" />
        </FrameLayout>

        <ImageButton
            android:id="@+id/btnHistory"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="히스토리"
            android:src="@drawable/ic_history" />

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="설정"
            android:src="@drawable/ic_settings" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
